        {"content": "UMOWA TEST/USL/2026/04", "polygon": [240, 237, 1242, 237, 1241, 317, 240, 311], "spans": [{"offset": 1566, "length": 22}]},
        {"content": "§ 4. Wynagrodzenie i rozliczenie", "polygon": [238, 400, 1002, 397, 1002, 449, 238, 454], "spans": [{"offset": 1589, "length": 32}]},
        {"content": "Łączne wynagrodzenie za wykonanie usługi wynosi 2 400,00 zł. Obejmuje ono wszystkie czynności", "polygon": [235, 495, 2242, 495, 2242, 546, 235, 547], "spans": [{"offset": 1622, "length": 93}]},
        {"content": "wskazane w załączniku nr 1, przygotowanie zestawienia wyników oraz jedną turę poprawek", "polygon": [238, 563, 2244, 563, 2244, 613, 238, 612], "spans": [{"offset": 1716, "length": 86}]},
        {"content": "dotyczących zgodności ze zleceniem.", "polygon": [237, 631, 972, 630, 973, 678, 237, 681], "spans": [{"offset": 1803, "length": 35}]},
        {"content": "Płatność nastąpi w ciągu 14 dni od przyjęcia wyników usługi. Dane do rozliczenia zostaną przekazane", "polygon": [239, 732, 2243, 732, 2243, 785, 239, 785], "spans": [{"offset": 1839, "length": 99}]},
        {"content": "wraz z dokumentem rozliczeniowym. Wynagrodzenie nie obejmuje zadań, których nie wymieniono w", "polygon": [238, 799, 2242, 799, 2242, 853, 238, 853], "spans": [{"offset": 1939, "length": 92}]},
        {"content": "zakresie usługi.", "polygon": [239, 865, 545, 866, 544, 916, 239, 915], "spans": [{"offset": 2032, "length": 16}]},
        {"content": "§ 5. Odbiór wyników", "polygon": [236, 997, 719, 996, 720, 1052, 236, 1054], "spans": [{"offset": 2049, "length": 19}]},
        {"content": "Wykonawca przekaże katalog i zestawienie wyników na adres elektroniczny Zamawiającego.", "polygon": [237, 1094, 2241, 1094, 2241, 1147, 237, 1147], "spans": [{"offset": 2069, "length": 86}]},
        {"content": "Zamawiający sprawdzi kompletność przekazanych plików w terminie pięciu dni roboczych i wskaże", "polygon": [239, 1162, 2241, 1161, 2241, 1212, 239, 1213], "spans": [{"offset": 2156, "length": 93}]},
        {"content": "ewentualne rozbieżności z załącznikiem nr 1.", "polygon": [240, 1229, 1126, 1229, 1126, 1277, 240, 1277], "spans": [{"offset": 2250, "length": 44}]},
        {"content": "Zgłoszenie rozbieżności powinno wskazywać nazwę pliku, opis problemu oraz oczekiwany sposób", "polygon": [239, 1333, 2241, 1333, 2241, 1386, 239, 1385], "spans": [{"offset": 2295, "length": 91}]},
        {"content": "korekty. Wykonawca przekaże poprawioną wersję w ciągu trzech dni roboczych od uzyskania", "polygon": [239, 1399, 2239, 1399, 2239, 1452, 239, 1453], "spans": [{"offset": 2387, "length": 87}]},
        {"content": "kompletnych informacji.", "polygon": [239, 1467, 721, 1466, 721, 1516, 239, 1517], "spans": [{"offset": 2475, "length": 23}]},
        {"content": "§ 6. Zasady współpracy", "polygon": [233, 1598, 790, 1599, 790, 1655, 233, 1654], "spans": [{"offset": 2499, "length": 22}]},
        {"content": "Strony będą informowały się o przeszkodach wpływających na termin wykonania usługi. Materiały", "polygon": [237, 1695, 2240, 1695, 2240, 1747, 237, 1747], "spans": [{"offset": 2522, "length": 93}]},
        {"content": "robocze służą wyłącznie realizacji niniejszego zlecenia. Po odbiorze wyników dodatkowe kopie", "polygon": [240, 1762, 2240, 1761, 2240, 1812, 240, 1814], "spans": [{"offset": 2616, "length": 92}]},
        {"content": "robocze zostaną usunięte.", "polygon": [239, 1831, 759, 1832, 759, 1880, 239, 1878], "spans": [{"offset": 2709, "length": 25}]},
        {"content": "§ 7. Postanowienia końcowe", "polygon": [237, 1960, 911, 1959, 911, 2011, 237, 2013], "spans": [{"offset": 2735, "length": 26}]},
        {"content": "Zmiany zakresu wymagają uzgodnienia przez obie strony. Umowę sporządzono w dwóch", "polygon": [239, 2059, 2241, 2058, 2241, 2109, 239, 2109], "spans": [{"offset": 2762, "length": 80}]},
        {"content": "egzemplarzach, po jednym dla każdej ze stron. Załącznik nr 1 jest częścią umowy i znajduje się na", "polygon": [237, 2125, 2239, 2125, 2239, 2176, 237, 2177], "spans": [{"offset": 2843, "length": 97}]},
        {"content": "następnej stronie.", "polygon": [238, 2194, 603, 2191, 604, 2241, 238, 2243], "spans": [{"offset": 2941, "length": 18}]},
