# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
APP_ALLOWED_HOSTS=["*"]

# Database
POSTGRES_USER=docanalyzer
POSTGRES_PASSWORD=docanalyzer
POSTGRES_DB=doc_analyzer
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docanalyzer:docanalyzer@db:5432/doc_analyzer

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_DAY=5
# Address of the frontend, used in the link sent in the reset email
FRONTEND_URL=http://localhost:5173

# Limits of requests per client IP on login, registration and email links (uses Redis)
RATE_LIMIT_ENABLED=true

# Email verification: new accounts confirm their email before logging in.
# Off in development; production turns it on in docker-compose.prod.yml
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_PER_DAY=5

# Email (SMTP). Leave SMTP_HOST empty to skip sending; in development the message
# (with the reset link) is written to the API log instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=CerberDoc <no-reply@cerberdoc.com>

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_key_here

# Azure OpenAI (for legal analysis), optional
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
# Deployments of the Azure OpenAI resource that a user can pick for the legal analysis
AZURE_OPENAI_MODELS=["gpt-6.1-terra","gpt-6.1-sol","gpt-6-luna","gpt-4.1","gpt-4.1-mini","gpt-4.1-nano"]
AZURE_OPENAI_DEFAULT_MODEL=gpt-6.1-terra

# File storage
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf","jpg","jpeg","png"]
CLASSIFIER_MODEL_PATH=storage/classifier_model.joblib
CLASSIFIER_MIN_CONFIDENCE=0.45

# Logging
LOG_LEVEL=INFO

# Local OCR / Redaction
LOCAL_OCR_LANG=pol+eng
LOCAL_OCR_DPI=300
LOCAL_OCR_MIN_CONFIDENCE=30
REDACTION_BOX_PADDING_PX=8
REDACTION_TIMEOUT_SECONDS=120
